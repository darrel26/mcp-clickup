{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mcp-clickup",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DAEMON_LINK",
				"class_name": "DaemonLink",
				"script_name": "",
				"environment": ""
			}
		]
	},
	"exports": {
		"DaemonLink": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"vars": {
		"CLICKUP_KEY": "6HMETrQGzekbqaH2SLYMZGqjcLvxqqy0SMPWLViPf0U=",
		"DAEMON_KEY": "BXmZfyd1AkqtbgR7QA39VwsORjN8hTacPMuMRGCeavg=",
		"WORKER_WS_URL": "wss://mcp-clickup.dionisiusgunadi.workers.dev"
	}
}
